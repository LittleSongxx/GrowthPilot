    "section": "第二章 资质信息公示",
    "text": "第二章 资质信息公示",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
