  {
    "id": "meituan-merchant-disclosure:0001:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第一条【目的依据】 为规范平台信息公示行为,保障消费者知情权,促进网络餐饮服务市场透明公开,依据《食品安全法》、《网络食品安全违法行为查处办",
    "text": "第一条【目的依据】 为规范平台信息公示行为,保障消费者知情权,促进网络餐饮服务市场透明公开,依据《食品安全法》、《网络食品安全违法行为查处办法》、《网络餐饮服务经营者落实食品安全主体责任监督管理规定》等法律法规,结合平台实际情况,制定本制度。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0002:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第二条【适用范围】 本制度适用于平台及在平台内从事网络餐饮服务经营活动的入网餐饮服务提供者。平台负责制定和执行信息公示规则,入网商户应按要求",
    "text": "第二条【适用范围】 本制度适用于平台及在平台内从事网络餐饮服务经营活动的入网餐饮服务提供者。平台负责制定和执行信息公示规则,入网商户应按要求在平台页面公示相关信息。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0003:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第三条【基本原则】 信息公示应遵循真实、准确、完整、及时的原则,入网商户在平台展示的信息应当与实际情况相符,不得有虚假或引人误解的内容。",
    "text": "第三条【基本原则】 信息公示应遵循真实、准确、完整、及时的原则,入网商户在平台展示的信息应当与实际情况相符,不得有虚假或引人误解的内容。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
