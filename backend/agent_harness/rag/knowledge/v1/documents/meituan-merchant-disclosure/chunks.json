  },
  {
    "id": "meituan-merchant-disclosure:0017:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第十三条【日常监测】 平台应通过技术手段或审核检查及对入网商户公示信息的真实性、准确性进行抽查监测,对发现的问题及时通知商户整改。",
    "text": "第十三条【日常监测】 平台应通过技术手段或审核检查及对入网商户公示信息的真实性、准确性进行抽查监测,对发现的问题及时通知商户整改。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0018:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第十四条【违规处置】 入网商户未按本制度要求公示相关信息或公示信息不实的,平台应采取警告、限流、置休、下线等措施以促进其整改,对发现涉嫌重大",
    "text": "第十四条【违规处置】 入网商户未按本制度要求公示相关信息或公示信息不实的,平台应采取警告、限流、置休、下线等措施以促进其整改,对发现涉嫌重大违规线索的,及时报告监管部门。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
