  },
  {
    "id": "meituan-merchant-disclosure:0005:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第四条【经营资质公示】 入网商户应在平台店铺页面显著位置公示以下资质信息:",
    "text": "第四条【经营资质公示】 入网商户应在平台店铺页面显著位置公示以下资质信息:\n1. 营业执照(须与平台登记信息一致);\n2. 食品经营许可证或经当地主管部门认可的相关资质(须与平台登记信息一致);\n3. 其他依法需要公示的身份信息。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0006:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第五条【资质变更管理】 入网商户经营资质发生变更(换证、增项、注销等)时,应当及时向平台提交更新申请。平台应在资质核验通过后更新页面公示信息",
    "text": "第五条【资质变更管理】 入网商户经营资质发生变更(换证、增项、注销等)时,应当及时向平台提交更新申请。平台应在资质核验通过后更新页面公示信息,不得展示失效或无效的资质信息。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0007:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第三章 经营信息公示",
    "text": "第三章 经营信息公示",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0008:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第六条【门面信息公示】 入网商户应当在平台店铺页面主动上传并公示真实经营门面照片,照片应清晰展示门店外观、招牌名称,确保与实体经营场所一致。",
    "text": "第六条【门面信息公示】 入网商户应当在平台店铺页面主动上传并公示真实经营门面照片,照片应清晰展示门店外观、招牌名称,确保与实体经营场所一致。当线下门面发生变更的,入网商户应当及时向平台提交更新的门面照片信息。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0009:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第七条【经营地址公示】 入网商户应在平台页面准确标注实际经营地址,标注地址应与食品经营许可证或经当地主管部门认可的相关资质等载明的经营场所地",
    "text": "第七条【经营地址公示】 入网商户应在平台页面准确标注实际经营地址,标注地址应与食品经营许可证或经当地主管部门认可的相关资质等载明的经营场所地址一致。当线下实际经营地址发生变更的,入网商户应先发起资质变更申请,再及时提交更新的展示地址信息。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0010:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第八条【特殊标识公示】 应按照相关法律法规要求设置和展示以下特殊标识:",
    "text": "第八条【特殊标识公示】 应按照相关法律法规要求设置和展示以下特殊标识:\n1. 在实际经营场所既不向消费者持续提供现场就餐服务,也不向消费者持续提供自提服务的商户,入网商户应在店铺页面显著位置设置无堂食标识;平台在门店列表页同步展示无堂食标识。\n2. 实施明厨亮灶(视频监控向消费者开放)的商户,应当在店铺页面显著位置设置明厨亮灶的链接标识;平台在门店列表页同步展示有/无明厨亮灶标识。\n3. 法律法规要求设置的其他消费提示标识。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0011:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第九条【商品信息公示】 入网商户在平台公示的菜品信息应当真实,不得有虚假内容。商户经营商品应在食品经营许可证载明的范围内,不得超范围经营。",
    "text": "第九条【商品信息公示】 入网商户在平台公示的菜品信息应当真实,不得有虚假内容。商户经营商品应在食品经营许可证载明的范围内,不得超范围经营。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0012:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第四章 公示信息管理",
    "text": "第四章 公示信息管理",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0013:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第十条【信息公示管理】",
    "text": "第十条【信息公示管理】\n平台应当要求入网餐饮服务提供者在店铺页面显著位置,持续展示经营资质、实体经营门面、实际经营地址等信息或者上述信息的链接标识;应当要求不提供堂食服务的入网餐饮服务提供者在其主页面显著位置设置无堂食标识;应当要求实施“互联网+明厨亮灶”的入网餐饮服务提供者在其主页面显著位置设置明厨亮灶的链接标识。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0014:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第十一条【技术支持】",
    "text": "第十一条【技术支持】\n平台应为入网餐饮服务提供者依法履行信息公示和展示义务,提供必要的技术支持。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0015:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第十二条【信息同步与更新】",
    "text": "第十二条【信息同步与更新】\n平台应根据入网餐饮服务提供者的设置,在列表页面同步展示无堂食、有/无明厨亮灶等标识,并根据入网商户信息的变更,及时更新对外展示内容。",
    "url": "https://rules-center.meituan.com/m/detail/guize/395005?activeRule=1",
    "fetched_at": "2026-11-01T02:44:59.279827+00:00",
    "published_at": "2026-05-29",
    "content_hash": "b2607052214de77277a24f64ab26d58e6de13b400e83873078aef03975daccbd",
    "business_type": "外卖餐饮",
    "document_type": "platform_rule"
  },
  {
    "id": "meituan-merchant-disclosure:0016:b2607052214d",
    "document_id": "meituan-merchant-disclosure",
    "scenario_id": "meituan_merchant",
    "title": "美团外卖信息公示制度",
    "section": "第五章 监管与违规处置",
    "text": "第五章 监管与违规处置",
