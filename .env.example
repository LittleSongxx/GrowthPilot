# 复制为 .env 并填写密钥；辅助模型的连接留空时沿用 Agent。

# 对话 Agent
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
AGENT_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# 评测裁判
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_EXTRA_BODY='{"thinking":{"type":"enabled"}}'
JUDGE_REASONING_EFFORT=high
JUDGE_TEMPERATURE=null

# 模拟客户
CUSTOMER_API_KEY=
CUSTOMER_BASE_URL=
CUSTOMER_MODEL=
CUSTOMER_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# 画像提取
PROFILE_API_KEY=
PROFILE_BASE_URL=
PROFILE_MODEL=
PROFILE_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# 语音服务
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ASR_MODEL=qwen3-asr-flash
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry

# 应用与数据库
SESSION_SECRET=
GROWTH_APP_PORT=8787
DATABASE_URL=postgresql://growth:growth_local@127.0.0.1:55432/growth
DATABASE_SCHEMA=growth
POSTGRES_PORT=55432
POSTGRES_PASSWORD=growth_local
